{
  "manifest_version": 3,
  "minimum_chrome_version": "140",
  "name": "PR Reviewer · Organizer",
  "version": "0.2.0",
  "description": "Organizes GitHub PR files and optionally reviews selected diffs with OpenAI, Gemini, or Claude.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://api.openai.com/*", "https://generativelanguage.googleapis.com/*", "https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
